{
  "include": [
    "ai-service/app"
  ],
  "exclude": [
    "**/__pyrefly_virtual__/**",
    "**/inmemory/**",
    "**/node_modules",
    "**/__pycache__",
    ".venv",
    ".next",
    "dist"
  ],
  "extraPaths": [
    "ai-service",
    "ai-service/venv/Lib/site-packages"
  ],
  "executionEnvironments": [
    {
      "root": "ai-service",
      "extraPaths": [
        "ai-service",
        "ai-service/venv/Lib/site-packages"
      ]
    }
  ],
  "venvPath": "ai-service",
  "venv": "venv",
  "pythonVersion": "3.10",
  "reportMissingImports": "none",
  "reportMissingTypeStubs": "none",
  "reportMissingModuleSource": "none",
  "reportOptionalMemberAccess": "none",
  "reportOptionalCall": "none"
}
