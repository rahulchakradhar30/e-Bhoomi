rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // HELPER FUNCTIONS — use custom claims, never Firestore lookups
    // Claims are set server-side by Admin SDK on account creation.
    // ============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // Read role directly from Firebase Auth custom claims (fast, no extra read)
    function claimRole() {
      return request.auth.token.role;
    }

    function isAdmin() {
      return isSignedIn() && (
        claimRole() == 'SYSTEM_ADMIN' ||
        claimRole() == 'STATE_ADMIN' ||
        request.auth.token.admin == true
      );
    }

    function isOfficer() {
      return isSignedIn() && (
        claimRole() == 'SYSTEM_ADMIN'    ||
        claimRole() == 'STATE_ADMIN'     ||
        claimRole() == 'DISTRICT_COLLECTOR' ||
        claimRole() == 'RDO_OFFICER'     ||
        claimRole() == 'TAHSILDAR_MRO'   ||
        claimRole() == 'FIELD_VRO'       ||
        // Legacy role names kept for compatibility
        claimRole() == 'DISTRICT_ADMIN'  ||
        claimRole() == 'RDO'             ||
        claimRole() == 'MRO'             ||
        claimRole() == 'FIELD_OFFICER'
      );
    }

    function isDistrictOrAbove() {
      return isSignedIn() && (
        claimRole() == 'SYSTEM_ADMIN'       ||
        claimRole() == 'STATE_ADMIN'        ||
        claimRole() == 'DISTRICT_COLLECTOR' ||
        claimRole() == 'DISTRICT_ADMIN'
      );
    }

    // Default deny all — explicit rules below grant access
    match /{document=**} {
      allow read, write: if false;
    }

    // ============================================================
    // OTP SESSIONS (admin login 2FA) — admin SDK only via backend
    // ============================================================
    match /adminOtpSessions/{sessionId} {
      allow read, write: if false; // server-side (Admin SDK) only
    }

    // ============================================================
    // USER PROFILES
    // ============================================================
    match /users/{userId} {
      // Own profile or any signed-in officer can read (for subordinate lookup)
      allow read: if isSignedIn() && (uid() == userId || isOfficer());
      // Admin SDK creates profiles (provisioning). Users can update their own.
      allow create: if isSignedIn() && uid() == userId;
      allow update: if isSignedIn() && (uid() == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // ============================================================
    // ADMIN PROFILES
    // ============================================================
    match /admins/{adminId} {
      allow read: if isSignedIn() && (uid() == adminId || isAdmin());
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ============================================================
    // OFFICER PROFILES
    // ============================================================
    match /officers/{officerId} {
      // Officers can read their own and any officer profile (directory access)
      allow read: if isSignedIn() && (uid() == officerId || isOfficer());
      allow create: if isAdmin();
      
      // Admin can update anything. Officers can only update their own mustChangePassword flag on first login.
      allow update: if isAdmin() || (isSignedIn() && uid() == officerId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword', 'updatedAt']));
      
      allow delete: if false; // Soft-delete only via accountStatus field
    }

    // ============================================================
    // OFFICER TRANSFERS
    // ============================================================
    match /officerTransfers/{transferId} {
      allow read: if isOfficer();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // ============================================================
    // ROLES & PERMISSIONS (reference data)
    // ============================================================
    match /roles/{roleId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /permissions/{permissionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ============================================================
    // JURISDICTIONS & MASTER DATA (public read)
    // ============================================================
    match /jurisdictions/{jurisdictionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /administrativeLocations/{locId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /states/{stateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /districts/{districtId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /revenueDivisions/{divisionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /mandals/{mandalId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sachivalayams/{sachivalayamId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /villages/{villageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================================
    // LAND RECORDS
    // ============================================================
    match /landRecords/{recordId} {
      allow read: if isSignedIn();
      allow create, update: if isOfficer();
      allow delete: if false;
    }

    // ============================================================
    // DIGITIZATION CASES & WORKFLOWS
    // ============================================================
    match /digitizationCases/{caseId} {
      allow read: if isOfficer();
      allow create, update: if isOfficer();
      allow delete: if false;
    }

    match /correctionRequests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isOfficer();
      allow delete: if false;
    }

    match /fieldVerifications/{verificationId} {
      allow read: if isOfficer();
      allow create, update: if isOfficer();
      allow delete: if false;
    }

    // ============================================================
    // AUDIT LOGS (append-only, admin read)
    // ============================================================
    match /auditLogs/{logId} {
      allow read: if isDistrictOrAbove();
      allow create: if isSignedIn(); // Any authenticated user can append
      allow update, delete: if false; // Immutable
    }

    // ============================================================
    // NOTIFICATIONS
    // ============================================================
    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow create, update: if isDistrictOrAbove() || isAdmin();
      allow delete: if isAdmin();
    }

    // ============================================================
    // DELEGATIONS
    // ============================================================
    match /delegations/{delegationId} {
      allow read: if isOfficer();
      allow create, update: if isOfficer();
      allow delete: if false;
    }
  }
}
