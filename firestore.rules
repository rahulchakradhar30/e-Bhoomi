rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // HELPER FUNCTIONS
    // ============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getOfficerData() {
      return get(/databases/$(database)/documents/officers/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && (
        (getUserData() != null && getUserData().role == role) ||
        (getOfficerData() != null && getOfficerData().roleId == role)
      );
    }

    function isOfficer() {
      return isSignedIn() && (
        hasRole('FIELD_OFFICER') ||
        hasRole('MRO') ||
        hasRole('RDO') ||
        hasRole('DISTRICT_ADMIN') ||
        hasRole('STATE_ADMIN') ||
        hasRole('SYSTEM_ADMIN')
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        hasRole('STATE_ADMIN') ||
        hasRole('SYSTEM_ADMIN')
      );
    }

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // ============================================================
    // USER PROFILES
    // ============================================================
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isOfficer());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isUser(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ============================================================
    // ADMIN PROFILES
    // ============================================================
    match /admins/{adminId} {
      allow read: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ============================================================
    // OFFICER PROFILES
    // ============================================================
    match /officers/{officerId} {
      allow read: if isOfficer();
      allow create, update: if isAdmin();
      allow delete: if false; // Officers cannot be deleted, only deactivated
    }

    // ============================================================
    // OFFICER TRANSFERS
    // ============================================================
    match /officerTransfers/{transferId} {
      allow read: if isOfficer();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // ============================================================
    // ROLES & PERMISSIONS
    // ============================================================
    match /roles/{roleId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /permissions/{permissionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ============================================================
    // JURISDICTIONS & MASTER DATA
    // ============================================================
    match /jurisdictions/{jurisdictionId} {
      allow read: if true; // Public administrative hierarchy view
      allow write: if isAdmin();
    }

    match /administrativeLocations/{locId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /states/{stateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /districts/{districtId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /revenueDivisions/{divisionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /mandals/{mandalId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /villages/{villageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================================
    // LAND RECORDS
    // ============================================================
    match /landRecords/{recordId} {
      allow read: if isSignedIn();
      allow create, update: if isOfficer();
      allow delete: if false;
    }

    // ============================================================
    // DIGITIZATION CASES & WORKFLOWS
    // ============================================================
    match /digitizationCases/{caseId} {
      allow read: if isOfficer();
      allow create, update: if isOfficer();
      allow delete: if false;
    }

    match /correctionRequests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isOfficer();
      allow delete: if false;
    }

    match /fieldVerifications/{verificationId} {
      allow read: if isOfficer();
      allow create, update: if hasRole('FIELD_OFFICER') || isOfficer();
      allow delete: if false;
    }

    // ============================================================
    // AUDIT LOGS
    // ============================================================
    match /auditLogs/{logId} {
      allow read: if isOfficer() && (hasRole('DISTRICT_ADMIN') || isAdmin());
      allow create: if isSignedIn();
      allow update, delete: if false; // Immutable audit log
    }

    // ============================================================
    // NOTIFICATIONS
    // ============================================================
    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow create, update: if hasRole('DISTRICT_ADMIN') || isAdmin();
      allow delete: if isAdmin();
    }

    // ============================================================
    // DELEGATIONS
    // ============================================================
    match /delegations/{delegationId} {
      allow read: if isOfficer();
      allow create, update: if hasRole('MRO') || hasRole('RDO') || isAdmin();
      allow delete: if false;
    }
  }
}
