{
  "include": [
    "app"
  ],
  "exclude": [
    "**/__pyrefly_virtual__/**",
    "**/inmemory/**",
    "**/node_modules",
    "**/__pycache__",
    "venv",
    ".venv"
  ],
  "extraPaths": [
    ".",
    "venv/Lib/site-packages"
  ],
  "executionEnvironments": [
    {
      "root": ".",
      "extraPaths": [
        ".",
        "venv/Lib/site-packages"
      ]
    }
  ],
  "venvPath": ".",
  "venv": "venv",
  "pythonVersion": "3.10",
  "reportMissingImports": "none",
  "reportMissingModuleSource": "none",
  "reportOptionalMemberAccess": "none",
  "reportOptionalCall": "none"
}
